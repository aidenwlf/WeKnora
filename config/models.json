{
  "providers": {
    "opencode-go": {
      "name": "OpenCode Go",
      "description": "OpenCode Go subscription models via the OpenAI-compatible Go inference endpoint.",
      "website": "https://opencode.ai",
      "api": "openai-completions",
      "base_url": "https://opencode.ai/inference/go/openai/v1",
      "requires_auth": true,
      "model_types": [
        "chat"
      ],
      "compat": {
        "thinking_format": "openai",
        "supports_reasoning_effort": true
      },
      "models": [
        {
          "id": "deepseek-v4.1-flash",
          "name": "DeepSeek V4.1 Flash",
          "reasoning": true,
          "input": [
            "text",
            "image"
          ],
          "context_window": 1000000,
          "max_output_tokens": 384000,
          "thinking_levels": {
            "off": null,
            "minimal": "low",
            "low": "low",
            "medium": "high",
            "high": "high",
            "xhigh": "max",
            "max": "max"
          }
        }
      ]
    }
  }
}
